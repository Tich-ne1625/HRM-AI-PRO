# Runtime mode: development, test, or production
APP_ENV=development

# Local PostgreSQL container settings. Keep the raw and URL-encoded values equivalent.
POSTGRES_DB=insighthr
POSTGRES_USER=insighthr
POSTGRES_PASSWORD=change-me@local-only
POSTGRES_PASSWORD_URLENCODED=change-me%40local-only

# Direct-host API settings. Docker Compose overrides the hostname with `postgres`.
DATABASE_URL=postgresql+psycopg://insighthr:change-me%40local-only@localhost:5432/insighthr
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
API_PORT=8000

# Authentication: this placeholder is allowed only in development.
# Test and production require an explicit nondefault key of at least 32 characters.
AUTH_ACCESS_SECRET=development-only-change-me-signing-key
WEB_ORIGIN=http://localhost:3000
# Use true in production and HTTPS deployments; false is for local HTTP development.
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_DAYS=7

# Next.js server-to-server API URL and future browser API prefix.
# Docker Compose overrides API_INTERNAL_URL with `http://api:8000`.
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
WEB_PORT=3000

